{
  "name": "scribo-next",
  "version": "8.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint && npm run format:check",
    "lint:fix": "eslint --fix && npm run format",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,mjs,cjs,scss,css}\" next.config.mjs next.config.test.mjs eslint.config.mjs vitest.config.mjs \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,mjs,cjs,scss,css}\" next.config.mjs next.config.test.mjs eslint.config.mjs vitest.config.mjs \"scripts/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource/geist": "^5.3.0",
    "@lexical/html": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@react-oauth/google": "^0.13.5",
    "lexical": "^0.39.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.104.1",
    "swagger-ui-dist": "^5.33.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
